<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tennis_universal_report_wizard_form" model="ir.ui.view">
        <field name="name">tennis.universal.report.wizard.form</field>
        <field name="model">tennis.universal.report.wizard</field>
        <field name="arch" type="xml">
            <form> <field name="report_type" invisible="1"/>

                <group>
                    <group string="Time Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Area of Analysis">
                        <field name="center_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="The Entire Network of Centers"/>
                    </group>
                </group>
                <footer>
                    <button name="button_generate_report" string="Generate PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>