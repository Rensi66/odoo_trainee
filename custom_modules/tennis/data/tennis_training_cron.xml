<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cron_training_update_state" model="ir.cron">
        <field name="name">Cron for training state update</field>
        <field name="model_id" ref="model_tennis_training"/>
        <field name="state">code</field>
        <field name="code">
            model._update_training_state()
        </field>
        <field name="interval_number">3</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="cron_training_reminder" model="ir.cron">
        <field name="name">Cron for training reminder</field>
        <field name="model_id" ref="model_tennis_training"/>
        <field name="state">code</field>
        <field name="code">
            model._remind_about_training()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>