<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tennis.CoachDashboard" owl="1">
        <div class="o_dash_wrapper p-4" style="background-color: #f8f9fa; min-height: 100vh;">

            <div class="h2 mb-4">Welcome back, <t t-esc="state.coachName || 'Coach'"/>! 👋</div>

            <div class="row mb-4">
                <div class="col-12 col-md-4 mb-3 mb-md-0">
                    <div class="card p-3 shadow-sm border-0 h-100" style="transition: transform 0.2s; cursor: pointer;">
                        <div class="text-muted small text-uppercase fw-bold">Trainings this month</div>
                        <div class="h3 mb-0 mt-2 text-primary">
                            <t t-esc="state.kpi.total_trainings || 0"/>
                        </div>
                        <div class="text-muted small mt-1">Completed Lessons</div>
                    </div>
                </div>

                <div class="col-12 col-md-4 mb-3 mb-md-0">
                    <div class="card p-3 shadow-sm border-0 h-100" style="transition: transform 0.2s; cursor: pointer;">
                        <div class="text-muted small text-uppercase fw-bold">Hours Worked</div>
                        <div class="h3 mb-0 mt-2 text-success">
                            <t t-esc="state.kpi.total_hours || 0"/> h.
                        </div>
                        <div class="text-muted small mt-1">Total Output</div>
                    </div>
                </div>

                <div class="col-12 col-md-4 mb-3 mb-md-0">
                    <div class="card p-3 shadow-sm border-0 h-100" style="transition: transform 0.2s; cursor: pointer;">
                        <div class="text-muted small text-uppercase fw-bold">Earned this month</div>
                        <div class="h3 mb-0 mt-2 text-dark fw-bold">
                            <t t-esc="state.kpi.total_salary_formatted || '0 $'"/>
                        </div>
                        <div class="text-success small mt-1">💸 Calculation Based on Personal Rate</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8 col-12 mb-4 mb-lg-0">
                    <div class="card p-4 shadow-sm border-0 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="mb-0 fw-bold">Plan for Today</h4>
                            <span class="badge bg-success-light text-success px-3 py-2 rounded">
                                <t t-esc="state.todayTrainings.length || 0"/> trainings
                            </span>
                        </div>

                        <t t-if="state.todayTrainings.length > 0">
                            <div class="training_list_scroll" style="max-height: 400px; overflow-y: auto;">
                                <t t-foreach="state.todayTrainings" t-as="training" t-key="training.id">
                                    <div class="training_item d-flex align-items-center border-bottom py-3 pe-2"
                                         t-on-click="() => this.onTrainingClick(training)"
                                         style="cursor: pointer; transition: background-color 0.2s;"
                                         onmouseover="this.style.backgroundColor='#f1f5f9'"
                                         onmouseout="this.style.backgroundColor='transparent'">

                                        <div class="time_badge me-3 text-center p-2 rounded bg-light" style="min-width: 65px;">
                                            <div class="fw-bold text-primary" t-esc="training.time"/>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark"><t t-esc="training.client_name"/></div>
                                            <div class="text-muted small d-flex align-items-center mt-1">
                                                <span class="me-3">
                                                    <i class="fa fa-map-marker me-1 text-danger"/>
                                                    <t t-esc="training.court_name"/>
                                                </span>
                                                <span>
                                                    <i class="fa fa-star me-1 text-warning"/>
                                                    <t t-esc="training.client_level"/>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="text-end d-flex flex-column align-items-end gap-1">
                                            <span class="badge rounded-pill px-2 py-1" style="background-color: #f5f3ff; color: #6d28d9; font-size: 0.75rem; font-weight: 500; border: 1px solid #ddd6fe;">
                                                <t t-esc="training.type_label"/>
                                            </span>

                                            <span t-attf-class="badge rounded-pill px-2 py-1 #{training.status_class}"
                                                  t-att-style="training.status_style + ' font-size: 0.8rem; font-weight: 600;'">
                                                <t t-esc="training.status_label"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-else="">
                            <div class="text-center p-5 text-muted my-auto">
                                <i class="fa fa-calendar-check-o fa-3x mb-3 text-muted" style="opacity: 0.5;"/>
                                <br/>
                                There are no confirmed training sessions for today.<br/>
                                <span class="small text-muted">You can have some coffee! ☕</span>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="col-lg-4 col-12">
                    <div class="card p-4 shadow-sm border-0 h-100 d-flex flex-column" style="overflow: hidden;">
                        <div class="mb-2">
                            <h4 class="mb-0 fw-bold text-nowrap">Revenue Analytics</h4>
                            <p class="text-muted small mb-0">Monthly Earnings History</p>
                        </div>

                        <div class="chart_container flex-grow-1 mt-3" style="position: relative; min-height: 280px; width: 100%;">

                            <canvas t-ref="coachChart"
                                    t-att-class="state.chartData.labels.length ? '' : 'd-none'"
                                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></canvas>

                            <t t-if="!state.chartData.labels.length">
                                <div class="d-flex align-items-center justify-content-center h-100 w-100 text-center text-muted py-5">
                                    <div>
                                        <i class="fa fa-bar-chart d-block fs-2 mb-2 text-warning" style="opacity: 0.5;"></i>
                                        <p class="small mb-0">No data available for charts for the last 6 months.</p>
                                    </div>
                                </div>
                            </t>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>