<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_tennis_training_stats_graph" model="ir.ui.view">
        <field name="name">tennis.training.stats.graph</field>
        <field name="model">tennis.training</field>
        <field name="arch" type="xml">
            <graph string="Revenue Analytics" type="bar" stacked="0" sample="1">
                <field name="start_datetime" interval="month"/>
                <field name="training_type"/>

                <field name="price_coach" type="measure" string="Earned Money"/>
                <field name="duration" type="measure" string="Hours Worked"/>
            </graph>
        </field>
    </record>

    <record id="view_tennis_training_stats_pivot" model="ir.ui.view">
        <field name="name">tennis.training.stats.pivot</field>
        <field name="model">tennis.training</field>
        <field name="arch" type="xml">
            <pivot string="Summary Table" sample="1">
                <field name="start_datetime" interval="month" type="row"/>
                <field name="training_type" type="row"/>

                <field name="price_coach" type="measure"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tennis_training_search" model="ir.ui.view">
        <field name="name">tennis.training.search</field>
        <field name="model">tennis.training</field>
        <field name="arch" type="xml">
            <search string="Search and Filters">
                <field name="display_coach" string="Court"/>
                <field name="court"/>

                <filter string="This month" name="current_month"
                        domain="[
                            ('start_datetime', '&gt;=', context_today().strftime('%Y-%m-01')),
                            ('start_datetime', '&lt;', (context_today() + datetime.timedelta(days=32)).strftime('%Y-%m-01'))
                        ]"/>

                <separator/>

                <field name="start_datetime" string="Select period (from / to)"/>

                <group expand="0" string="Group by">
                    <filter string="Date" name="group_by_date" context="{'group_by': 'start_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tennis_coach_analytics" model="ir.actions.act_window">
        <field name="name">Training Statistics</field>
        <field name="res_model">tennis.training</field>
        <field name="view_mode">graph,pivot,kanban,list</field>
        <field name="search_view_id" ref="view_tennis_training_search"/>

        <field name="domain">[
            ('tennis_coach_id.employee_id.user_id', '=', uid),
            ('state', '=', 'done')
        ]</field>

        <field name="context">{
            'search_default_current_month': 1
        }</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                You do not have any completed trainings in the selected period yet.
            </p>
            <p>
                Only completed activities (with the status "Completed") appear here.<br/>
                • To view the data <strong>of all time</strong>, simply click the small cross next to the purple "This Month" filter in the search bar at the top.<br/>
                • To select a custom interval, use the "Add Custom Filter" button.
            </p>
        </field>
    </record>

</odoo>