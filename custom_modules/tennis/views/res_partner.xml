<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_tennis_partner_search" model="ir.ui.view">
        <field name="name">res.partner.tennis.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Client Search">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
                <filter string="Tennis Clients" name="filter_is_tennis" domain="[('is_tennis_client', '=', True)]"/>
                <group expand="0" string="Grouping">
                    <filter string="Status" name="groupby_client_status" context="{'group_by': 'client_status'}"/>
                    <filter string="Skill Level" name="groupby_tennis_level" context="{'group_by': 'tennis_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tennis_partner_list" model="ir.ui.view">
        <field name="name">res.partner.tennis.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="My Clients" sample="1" create="0">
                <field name="name" string="Client" decoration-bf="1" readonly="1"/>
                <field name="phone" string="Contacts" readonly="1"/>
                <field name="email" string="Email" optional="hide" readonly="1"/>

                <field name="tennis_level" string="Level" widget="badge" optional="show"
                       decoration-info="tennis_level == 'beginner'"
                       decoration-warning="tennis_level == 'intermediate'"
                       decoration-danger="tennis_level == 'expert'"/>

                <field name="training_count" string="Trainings" icon="fa-calendar" decoration-bf="1"/>
                <field name="last_training_date" string="The Last One" widget="date" readonly="1"/>

                <field name="tennis_balance" string="Balance" widget="monetary"
                       decoration-danger="tennis_balance &lt; 0" sum="Total Balance"
                       groups="tennis.group_tennis_manager"/>

                <field name="client_status" string="Status" widget="badge" readonly="1"
                       decoration-success="client_status == 'active'"
                       decoration-muted="client_status == 'inactive'"
                       decoration-warning="client_status == 'new'"/>

                <button name="button_create_single_training"
                        string="Record"
                        type="object"
                        icon="fa-plus-circle"
                        class="btn-link text-success"/>
            </list>
        </field>
    </record>

    <record id="view_tennis_partner_kanban" model="ir.ui.view">
        <field name="name">res.partner.tennis.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="client_status"/>
                <field name="training_count"/>
                <templates>
                    <t t-name="card"> <div class="oe_kanban_global_click o_kanban_record_has_image_fill p-3">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image:url('#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}')"/>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <div>
                                    <strong class="o_kanban_record_title fs-5"><field name="name"/></strong>
                                    <div t-if="record.phone.raw_value" class="text-muted small mt-1">
                                        <i class="fa fa-phone me-1" title="Phone"/> <field name="phone"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="client_status" widget="badge"
                                               decoration-success="client_status == 'active'"
                                               decoration-muted="client_status == 'inactive'"
                                               decoration-warning="client_status == 'new'"/>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <span class="badge rounded-pill text-bg-success px-2 py-1">
                                        <i class="fa fa-history me-1" title="Number of trainings"/> Games: <field name="training_count"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tennis_partner_form" model="ir.ui.view">
        <field name="name">res.partner.tennis.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Tennis Client Profile">
                <sheet>
                    <field name="avatar_128" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>

                    <div class="oe_title">
                        <label for="name" string="Student's Full Name" class="oe_edit_only text-muted"/>
                        <h1>
                            <field name="name" default_focus="1" placeholder="For example: Alex Levon" required="1"/>
                        </h1>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6 border-end">
                            <h4 class="text-primary mb-3"><i class="fa fa-address-card-o me-2"/>Contact Details</h4>
                            <group var="contacts_group" class="oe_inline">
                                <field name="phone" widget="phone" string="📱 Phone"
                                       placeholder="+7 (999) 000-00-00"
                                       readonly="is_manager == False"/>

                                <field name="email" widget="email" string="✉️ Email"
                                       placeholder="client@example.com"
                                       readonly="is_manager == False"/>
                            </group>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h4 class="text-primary mb-3"><i class="fa fa-trophy me-2"/>Sports Profile</h4>
                            <group var="sports_group" class="oe_inline">
                                <field name="tennis_level" widget="radio" string="🎾 Level" options="{'horizontal': true}"/>
                                <field name="currency_id" invisible="1"/>

                                <field name="tennis_balance" widget="monetary" string="💰 Account Balance"
                                       decoration-danger="tennis_balance &lt; 0"
                                       decoration-success="tennis_balance &gt;= 0"
                                       groups="tennis.group_tennis_manager"/>

                                <field name="training_count" string="📊 Total Visits" class="fw-bold"/>
                                <field name="last_training_date" string="📅 The Last game" widget="date"/>
                            </group>
                        </div>
                    </div>

                    <notebook class="mt-4">
                        <page string="🩺 Medical Record" name="medical_page">
                            <div class="alert alert-info mb-3" role="alert" invisible="medical_notes">
                                This client's medical contraindications have not been filled out.
                            </div>
                            <group string="Restrictions, injuries, and health contraindications">
                                <field name="medical_notes" nolabel="1" placeholder="List any health issues here..."/>
                            </group>
                        </page>
                        <page string="📝 Coach's Notes" name="coach_page">
                            <group string="Player development plan and technical notes">
                                <field name="coach_private_notes" nolabel="1" placeholder="Describe the player's strengths and weaknesses..." options="{'collaborative': true, 'resizable': true}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tennis_clients" model="ir.actions.act_window">
            <field name="name">Center Clients</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'search_default_groupby_client_status': 1}</field>

            <field name="domain">[('training_count', '>', 0)]</field>

            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_tennis_partner_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_tennis_partner_kanban')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_tennis_partner_form')})]"/>
    </record>

</odoo>