<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_pnl_pdf" model="ir.actions.report">
        <field name="name">Consolidated P&amp;L Report</field>
        <field name="model">tennis.universal.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tennis.report_pnl_template</field>
        <field name="report_file">tennis.report_pnl_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_pnl_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <div class="text-center mb-5">
                        <h2>Consolidated Profit and Loss Statement (P&amp;L)</h2>
                        <h4>Analysis Period: <t t-out="date_from"/> — <t t-out="date_to"/></h4>
                    </div>

                    <table class="table table-bordered table-striped">
                        <thead class="bg-200">
                            <tr>
                                <th>Sports Center</th>
                                <th class="text-center">Number of trainings</th>
                                <th class="text-right">Gross Receipts (Clients)</th>
                                <th class="text-right">Expenses (Coaches)</th>
                                <th class="text-right">Net profit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="centers" t-as="center">
                                <tr>
                                    <td>
                                        <strong t-out="center['name']"/><br/>
                                        <small class="text-muted" t-out="center['address']"/>
                                    </td>
                                    <td class="text-center align-middle" t-out="center['trainings_count']"/>
                                    <td class="text-right align-middle">
                                        <span t-out="center['gross']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-right align-middle text-danger">
                                        - <span t-out="center['expenses']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-right align-middle font-weight-bold text-success">
                                        <span t-out="center['net']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="bg-100 font-weight-bold" style="border-top: 2px solid #000;">
                                <td>ИТОГО ПО СЕТИ</td>
                                <td class="text-center"><t t-out="total_trainings"/></td>
                                <td class="text-right">
                                    <span t-out="total_gross" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-right text-danger">
                                    - <span t-out="total_expenses" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-right text-success" style="font-size: 16px;">
                                    <span t-out="total_net" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>