<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_court_analysis_pdf" model="ir.actions.report">
        <field name="name">Анализ эффективности корт-часа</field>
        <field name="model">tennis.universal.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tennis.report_court_analysis_template</field>
        <field name="report_file">tennis.report_court_analysis_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_court_analysis_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <div class="text-center mb-5">
                        <h2>Анализ эффективности использования корт-часов</h2>
                        <h4>Период анализа: <t t-out="date_from"/> — <t t-out="date_to"/></h4>
                    </div>

                    <table class="table table-bordered table-striped">
                        <thead class="bg-200">
                            <tr>
                                <th>Теннисный корт</th>
                                <th>Спортивный中心 (Филиал)</th>
                                <th class="text-center">Кол-во оплаченных сессий (часов)</th>
                                <th class="text-right">Сгенерированная выручка</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="courts" t-as="court">
                                <tr>
                                    <td>
                                        <strong t-out="court['court_name']"/>
                                    </td>
                                    <td class="align-middle" t-out="court['center_name']"/>
                                    <td class="text-center align-middle" t-out="court['hours_count']"/>
                                    <td class="text-right align-middle text-success font-weight-bold">
                                        <span t-out="court['revenue']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="bg-100 font-weight-bold" style="border-top: 2px solid #000;">
                                <td colspan="2">ИТОГО ПО ВСЕМ КОРТАМ</td>
                                <td class="text-center">
                                    <t t-out="sum(c['hours_count'] for c in courts)"/>
                                </td>
                                <td class="text-right text-success" style="font-size: 16px;">
                                    <span t-out="total_revenue" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>